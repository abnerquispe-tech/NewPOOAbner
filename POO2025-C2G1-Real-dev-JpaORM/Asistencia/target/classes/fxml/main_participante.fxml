<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="700.0" prefWidth="1150.0" style="-fx-background-color: linear-gradient(to bottom right, #1e1f29, #2e354f); -fx-background-radius: 12;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.edu.upeu.asistencia.control.BoletoController">
    <children>

        <!-- TÍTULO PRINCIPAL -->
        <VBox alignment="CENTER" spacing="10" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="30.0">
            <Label style="-fx-font-size: 28px; -fx-font-weight: bold;" text=" Venta de Boletos Aéreos" textFill="#E0E0E0" />
            <Label style="-fx-font-size: 14px; -fx-opacity: 0.8;" text="Registra y visualiza los boletos vendidos" textFill="#B5ABD1" />
        </VBox>

        <!-- IMAGEN SUPERIOR -->
        <ImageView fitHeight="100.0" fitWidth="100.0" preserveRatio="true" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="90.0">

        </ImageView>

        <!-- CONTENIDO PRINCIPAL -->
        <HBox alignment="CENTER" spacing="30" AnchorPane.bottomAnchor="80.0" AnchorPane.leftAnchor="50.0" AnchorPane.rightAnchor="50.0" AnchorPane.topAnchor="230.0">

            <!-- FORMULARIO -->
            <VBox alignment="CENTER_LEFT" prefHeight="534.0" prefWidth="508.0" spacing="18" style="-fx-background-color: #2e334a; -fx-background-radius: 15; -fx-padding: 25;">
                <children>
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <ImageView fitHeight="40.0" fitWidth="40.0" preserveRatio="true">

                        </ImageView>
                        <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Datos del Pasajero" textFill="#E0E0E0" />
                    </HBox>

                    <Separator />

                    <GridPane hgap="10" vgap="12">
                        <columnConstraints>
                            <ColumnConstraints halignment="LEFT" minWidth="110" />
                            <ColumnConstraints hgrow="ALWAYS" />
                        </columnConstraints>

                        <children>
                            <Label text="Nombre:" textFill="#B5ABD1" GridPane.rowIndex="0" />
                            <TextField fx:id="txtNombre" promptText="Nombre completo" style="-fx-background-color: #3b4060; -fx-text-fill: white; -fx-background-radius: 8; -fx-prompt-text-fill: #AAAAAA;" GridPane.columnIndex="1" />

                            <Label text="DNI:" textFill="#B5ABD1" GridPane.rowIndex="1" />
                            <TextField fx:id="txtDni" promptText="Documento de identidad" style="-fx-background-color: #3b4060; -fx-text-fill: white; -fx-background-radius: 8; -fx-prompt-text-fill: #AAAAAA;" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                            <Label text="Correo:" textFill="#B5ABD1" GridPane.rowIndex="2" />
                            <TextField fx:id="txtCorreo" promptText="correo@ejemplo.com" style="-fx-background-color: #3b4060; -fx-text-fill: white; -fx-background-radius: 8; -fx-prompt-text-fill: #AAAAAA;" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                            <Label text="Teléfono:" textFill="#B5ABD1" GridPane.rowIndex="3" />
                            <TextField fx:id="txtTelefono" promptText="+51 999 999 999" style="-fx-background-color: #3b4060; -fx-text-fill: white; -fx-background-radius: 8; -fx-prompt-text-fill: #AAAAAA;" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                            <Label text="Origen:" textFill="#B5ABD1" GridPane.rowIndex="4" />
                            <ComboBox fx:id="cbxOrigen" promptText="Seleccionar origen" style="-fx-background-color: #3b4060; -fx-text-fill: white; -fx-background-radius: 8;" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                            <Label text="Destino:" textFill="#B5ABD1" GridPane.rowIndex="5" />
                            <ComboBox fx:id="cbxDestino" promptText="Seleccionar destino" style="-fx-background-color: #3b4060; -fx-text-fill: white; -fx-background-radius: 8;" GridPane.columnIndex="1" GridPane.rowIndex="5" />

                            <Label text="Fecha Vuelo:" textFill="#B5ABD1" GridPane.rowIndex="6" />
                            <DatePicker fx:id="dpFechaVuelo" style="-fx-background-color: #3b4060; -fx-text-fill: white; -fx-background-radius: 8;" GridPane.columnIndex="1" GridPane.rowIndex="6" />

                            <Label text="Clase:" textFill="#B5ABD1" GridPane.rowIndex="7" />
                            <ComboBox fx:id="cbxClase" promptText="Económica / Ejecutiva" style="-fx-background-color: #3b4060; -fx-text-fill: white; -fx-background-radius: 8;" GridPane.columnIndex="1" GridPane.rowIndex="7" />

                            <Label text="Precio:" textFill="#B5ABD1" GridPane.rowIndex="8" />
                            <TextField fx:id="txtPrecio" promptText="S/ 0.00" style="-fx-background-color: #3b4060; -fx-text-fill: white; -fx-background-radius: 8; -fx-prompt-text-fill: #AAAAAA;" GridPane.columnIndex="1" GridPane.rowIndex="8" />
                        </children>
                        <rowConstraints>
                            <RowConstraints />
                            <RowConstraints />
                            <RowConstraints />
                            <RowConstraints />
                            <RowConstraints />
                            <RowConstraints />
                            <RowConstraints />
                            <RowConstraints />
                            <RowConstraints />
                        </rowConstraints>
                    </GridPane>

                    <!-- BOTONES -->
                    <HBox alignment="CENTER" spacing="20">
                        <Button onAction="#venderBoleto" prefWidth="160" style="-fx-background-color: #43bb73; -fx-text-fill: white; -fx-font-size: 15px; -fx-background-radius: 10; -fx-cursor: hand;" text="Vender Boleto" />
                        <Button onAction="#limpiarCampos" prefWidth="110" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-size: 15px; -fx-background-radius: 10; -fx-cursor: hand;" text="Limpiar" />
                    </HBox>

                    <Label fx:id="lblMensaje" style="-fx-font-size: 12px; -fx-opacity: 0.8;" textFill="#B5ABD1" wrapText="true" />
                </children>
            </VBox>

            <!-- TABLA DERECHA -->
            <VBox alignment="TOP_CENTER" prefHeight="650.0" prefWidth="932.0" spacing="15" style="-fx-background-color: #2e334a; -fx-background-radius: 15; -fx-padding: 25;">
                <children>
                    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text=" Boletos Vendidos" textFill="#E0E0E0" />
                    <Separator />
                    <TableView fx:id="tblBoletos" prefHeight="424.0" prefWidth="791.0" style="-fx-background-color: #3b4060; -fx-background-radius: 8;" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn prefWidth="90.0" text="DNI" />
                            <TableColumn prefWidth="150.0" text="Nombre" />
                            <TableColumn prefWidth="110.0" text="Origen" />
                            <TableColumn prefWidth="110.0" text="Destino" />
                            <TableColumn prefWidth="130.0" text="Fecha Vuelo" />
                            <TableColumn prefWidth="90.0" text="Clase" />
                            <TableColumn prefWidth="90.0" text="Precio" />
                        </columns>
                    </TableView>
                </children>
            </VBox>

        </HBox>

        <!-- PIE DE PÁGINA -->
        <Label alignment="CENTER" style="-fx-font-size: 11px;" text="© 2025 SysAir - Todos los derechos reservados" textFill="#7a7a7a" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" />

    </children>
</AnchorPane>
