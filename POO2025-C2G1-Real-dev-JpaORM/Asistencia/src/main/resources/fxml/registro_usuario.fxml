<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pe.edu.upeu.asistencia.control.RegistroUsuarioController"
            prefWidth="700.0" prefHeight="520.0"
            style="-fx-background-color: linear-gradient(to bottom right, #004D40, #00796B);
                   -fx-background-radius: 15;">

    <VBox spacing="15.0" alignment="TOP_CENTER" prefWidth="700" prefHeight="520">
        <padding>
            <Insets top="20" right="20" bottom="20" left="20"/>
        </padding>

        <!-- 🟢 Título -->
        <Label text="Registro de Nuevo Usuario"
               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;" />

        <!-- 🟢 Formulario -->
        <GridPane hgap="15" vgap="15" alignment="CENTER">
            <TextField fx:id="txtNombre"
                       promptText="Nombre completo"
                       GridPane.rowIndex="0" GridPane.columnIndex="0" GridPane.columnSpan="2"
                       style="-fx-background-radius: 8; -fx-background-color: rgba(255,255,255,0.9);
                               -fx-font-size: 14px;" />

            <TextField fx:id="txtCorreo"
                       promptText="Correo electrónico"
                       GridPane.rowIndex="1" GridPane.columnIndex="0" GridPane.columnSpan="2"
                       style="-fx-background-radius: 8; -fx-background-color: rgba(255,255,255,0.9);
                               -fx-font-size: 14px;" />

            <TextField fx:id="txtCodigo"
                       promptText="Código de usuario"
                       GridPane.rowIndex="2" GridPane.columnIndex="0" GridPane.columnSpan="2"
                       style="-fx-background-radius: 8; -fx-background-color: rgba(255,255,255,0.9);
                               -fx-font-size: 14px;" />

            <Button text="Guardar"
                    onAction="#guardarUsuario"
                    GridPane.rowIndex="3" GridPane.columnIndex="0"
                    style="-fx-background-color: #76FF03;
                           -fx-text-fill: black;
                           -fx-font-weight: bold;
                           -fx-background-radius: 10;
                           -fx-padding: 8 25;
                           -fx-font-size: 14px;" />

            <Button text="Limpiar"
                    onAction="#limpiarCampos"
                    GridPane.rowIndex="3" GridPane.columnIndex="1"
                    style="-fx-background-color: #FFCA28;
                           -fx-text-fill: black;
                           -fx-font-weight: bold;
                           -fx-background-radius: 10;
                           -fx-padding: 8 25;
                           -fx-font-size: 14px;" />
        </GridPane>

        <!-- 🟢 Mensaje de validación -->
        <Label fx:id="lblMensaje"
               text=""
               wrapText="true"
               style="-fx-font-size: 14px; -fx-text-fill: white; -fx-font-weight: bold;" />

        <!-- 🟢 Tabla de usuarios -->
        <TableView fx:id="tablaUsuarios" prefHeight="220" prefWidth="640"
                   style="-fx-background-radius: 10; -fx-background-color: rgba(255,255,255,0.9);">
            <columns>
                <TableColumn fx:id="colNombre" text="Nombre" prefWidth="200"/>
                <TableColumn fx:id="colCorreo" text="Correo Electrónico" prefWidth="220"/>
                <TableColumn fx:id="colCodigo" text="Código" prefWidth="120"/>
                <TableColumn fx:id="colAcciones" text="Acciones" prefWidth="100"/>
            </columns>
        </TableView>
    </VBox>
</AnchorPane>
